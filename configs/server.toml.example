[server]
data_dir = "~/.murmur"
system_prompt_file = "~/.murmur/system_prompt.md"
# debug_channel = "#murmur-debug"  # DEPRECATED: use [debug] section below

[irc]
server = "irc.example.com"
port = 6697
tls = true
nick = "murmur"
user = "murmur"
realname = "Murmur Agent"
password = ""
nickserv_password = ""
# oper_user = "admin"
# oper_password = "vault:irc-oper-password"

[irc.channels]
main = "#murmur"
bus = "#murmur-bus"

[llm]
default = "openrouter-claude"

[llm.providers.openrouter-claude]
api_base = "https://openrouter.ai/api/v1"
api_key = "vault:openrouter-key"
model = "anthropic/claude-sonnet-4-5"
max_tokens = 8192
temperature = 0.7
# fallbacks = ["openrouter-gpt"]  # try these providers on 5xx/429 errors

# [llm.providers.openrouter-gpt]
# api_base = "https://openrouter.ai/api/v1"
# api_key = "vault:openrouter-key"
# model = "openai/gpt-4.1"
# max_tokens = 8192
# temperature = 0.7

# [llm.providers.kimi]
# api_base = "https://api.moonshot.cn/v1"
# api_key = "vault:kimi-key"
# model = "moonshot-v1-128k"
# max_tokens = 8192
# temperature = 0.7

# [llm.providers.ollama]
# api_base = "http://localhost:11434/v1"
# api_key = "dummy"
# model = "llama3.1:70b"
# max_tokens = 4096
# temperature = 0.7

[memory]
db_path = "~/.murmur/memory.db"
max_history = 100
# summary_model = ""          # LLM provider name for summarization (must exist in [llm.providers])
# summary_threshold = 80      # message count that triggers summarization (default: 80% of max_history)
# cross_channel_context = 10  # recent messages per other channel included in system prompt (-1 to disable)

# RAG (Retrieval-Augmented Generation) memory search.
# Enables FTS5 full-text search over ingested documents and conversation summaries.
# Optionally add an embedding provider for hybrid semantic + keyword search.
# Works with any OpenAI-compatible embeddings API (OpenRouter, Ollama, local, etc.).
# [memory.rag]
# enabled = true
# auto_ingest_summaries = true  # auto-ingest conversation summaries (default: true)
# files = ["~/.murmur/knowledge/readme.md"]  # files to index on startup

# Optional: embedding provider for semantic search (FTS5-only if omitted).
# Any OpenAI-compatible /v1/embeddings endpoint works (OpenRouter, Ollama, local, etc.).
# [memory.rag.embeddings]
# api_base = "http://localhost:11434/v1"  # e.g., Ollama local
# api_key = ""                            # not needed for local Ollama
# model = "nomic-embed-text"
# dimensions = 768

[scheduler]
enabled = true
heartbeat_interval = "5m"
client_timeout = "2m"
tick_interval = "30s"     # how often to check for due tasks (minimum granularity)
max_concurrent = 3        # max simultaneous scheduled tasks
# Per-task model assignment: scheduled tasks can specify an LLM provider override.
# Use the --provider flag with !task add, or the "provider" field in the task_add tool.
# Example: !task add --provider=ollama-local 0 9 * * * Summarize overnight logs
# If the provider doesn't exist at runtime, the task falls back to channel/global default.

[approval]
# timeout = "2m"  # how long to wait for user !approve/!deny before auto-denying

[security]
allowed_users = ["yournick"]
require_nickserv = true
bus_key = ""
# permissions_file = "~/.murmur/permissions.toml"  # user/channel permissions (default: <data_dir>/permissions.toml)

[vault]
enabled = false
db_path = "~/.murmur/vault.db"
passphrase_env = "MURMUR_VAULT_PASS"

# --- Server-side tools ---
# These tools execute on the server and are available to the LLM agent.
# Client-side tools (shell, code_exec, etc.) can also be configured here
# if the server should run them locally instead of routing to clients.

# SearXNG search: query a self-hosted SearXNG instance for web search.
# Requires a running SearXNG instance (see docker-compose.yml, profile "search").
# [tools.searxng]
# enabled = true
# url = "http://localhost:8080"
# max_results = 10

# OpenCode: interact with an OpenCode coding agent via REST+SSE API.
# Requires a running OpenCode instance (see docker-compose.yml, profile "opencode").
# [tools.opencode]
# enabled = true
# url = "http://localhost:3000"
# username = ""
# password = "vault:opencode-password"
# session_timeout = "5m"

# Config management: read and write the server TOML config at runtime.
# Security deny-list prevents modifying sensitive fields (passwords, API keys, vault).
# [tools.config_manage]
# enabled = true
# config_path = "~/.murmur/server.toml"

# IRC management: join/part channels, send messages, read cross-channel history.
# [tools.irc_manage]
# enabled = true

# Browser automation: headless browser via Dockerized Playwright.
# Requires the browser service (see docker-compose.yml, profile "browser").
# Use "http://browser:3001" when running inside Docker Compose,
# or "http://localhost:3001" when running the server on the host.
# [tools.browser]
# enabled = true
# endpoint = "http://localhost:3001"  # use "http://browser:3001" in Docker Compose
# timeout = "30s"
# max_content_length = 8000

# Shell: execute commands inside ephemeral Docker containers.
# [tools.shell]
# enabled = true
# docker_image = "ubuntu:24.04"
# network = false
# memory_limit = "256m"
# cpu_limit = "0.5"
# timeout = "30s"

# Code execution: sandboxed code execution via self-hosted Piston API.
# [tools.code_exec]
# enabled = true
# piston_url = "http://localhost:2000"
# default_language = "python"

# RSS feed reader
# [tools.rss]
# enabled = true
# max_items = 10

# DNS/SSL check
# [tools.dns]
# enabled = true

# Web search (Brave Search API)
# [tools.web_search]
# enabled = true
# api_key = "vault:brave-search-key"
# max_results = 5

# --- Debug channel ---
# Live structured log output to an IRC channel for real-time debugging.
# [debug]
# enabled = true
# channel = "#murmur-debug"
# log_level = "debug"          # minimum level: debug, info, warn, error
# log_tool_calls = true        # log tool call routing and results
# log_llm_requests = true      # log LLM API calls with provider, tokens, latency
# log_bus_protocol = false     # log bus protocol messages (reserved for future use)
# log_permissions = true       # log permission checks and denials
